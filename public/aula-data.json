  "courses": [
    {
      "id": "ai-410",
      "code": "AI 410",
      "color": "caracol",
      "final": "Inference engine repo and benchmark write-up",
      "grading": "weighted",
      "hours": 6,
      "number": "410",
      "order": 1,
      "summary": "Build a small inference engine on the forward pass from Raschka, profile it, then write Triton kernels for the hot paths.",
      "tagline": "Below the abstraction layer",
      "title": "Inference Systems"
    },
    {
      "id": "ai-420",
      "code": "AI 420",
      "color": "sky",
      "final": "Technical report and community post",
      "grading": "weighted",
      "hours": 4,
      "number": "420",
      "order": 2,
      "summary": "Measure how much extraction quality a 3–4-bit 8B model loses on Tagger documents, and how much scaffolding or a QLoRA adapter wins back.",
      "tagline": "Quantization and recovery",
      "title": "Evaluation Methods"
    },
    {
      "id": "ai-430",
      "code": "AI 430",
