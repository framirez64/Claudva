  "modules": [
    {
      "id": "ai-410-m1",
      "courseId": "ai-410",
      "summary": "Build the GPT forward pass from Raschka. Work out the 3090's decoding ceiling and measure how close llama.cpp gets.",
      "title": "Model internals",
      "weekEnd": 3,
      "weekStart": 1
    },
    {
      "id": "ai-410-m2",
      "courseId": "ai-410",
      "summary": "Add a KV cache and batched generation to your model. Read the PagedAttention paper.",
      "title": "KV cache and batching",
      "weekEnd": 5,
      "weekStart": 4
    },
    {
      "id": "ai-410-m3",
      "courseId": "ai-410",
      "summary": "Profile your engine with torch.profiler, Nsight Systems and Nsight Compute. Write up where the time goes.",
      "title": "Profiling",
      "weekEnd": 6,
      "weekStart": 6
    },
    {
      "id": "ai-410-m4",
      "courseId": "ai-410",
      "summary": "Write RMSNorm and softmax kernels in Triton and benchmark them against PyTorch.",
      "title": "Triton I",
      "weekEnd": 8,
      "weekStart": 7
    },
    {
      "id": "ai-410-m5",
      "courseId": "ai-410",
      "summary": "A 4-bit dequantize and matrix-vector kernel, the operation that dominates decoding. Week 9 is light.",
      "title": "Triton II",
      "weekEnd": 10,
      "weekStart": 9
    },
    {
      "id": "ai-410-m6",
      "courseId": "ai-410",
      "summary": "Add a paged KV cache and compare your design with nano-vllm.",
      "title": "Paged KV cache",
      "weekEnd": 11,
      "weekStart": 11
    },
    {
      "id": "ai-410-m7",
      "courseId": "ai-410",
      "summary": "Ship the engine repo with a write-up benchmarking it against llama.cpp.",
      "title": "Final",
      "weekEnd": 12,
      "weekStart": 12
    },
    {
      "id": "ai-420-m1",
      "courseId": "ai-420",
      "summary": "Build a gold-labeled extraction set of 100–200 documents from Tagger and define your metrics.",
      "title": "Evaluation design",
      "weekEnd": 2,
      "weekStart": 1
    },
    {
      "id": "ai-420-m2",
      "courseId": "ai-420",
      "summary": "Run BF16, Q8, Q6, Q4 and Q3 on the 3090, recording quality and tokens per second. Release the tool.",
      "title": "Quantization sweep",
      "weekEnd": 5,
      "weekStart": 3
    },
    {
      "id": "ai-420-m3",
      "courseId": "ai-420",
      "summary": "Add few-shot prompting, self-consistency and verify-and-retry, then a QLoRA adapter on the quantized base.",
      "title": "Recovery methods",
      "weekEnd": 8,
      "weekStart": 6
    },
    {
      "id": "ai-420-m4",
      "courseId": "ai-420",
      "summary": "One rented-GPU session testing MXFP4, the 4-bit format the 3090 cannot run.",
      "title": "MXFP4",
      "weekEnd": 10,
      "weekStart": 10
    },
    {
      "id": "ai-420-m5",
      "courseId": "ai-420",
      "summary": "Write the technical report, then post it to r/LocalLLaMA and Hacker News.",
      "title": "Report",
      "weekEnd": 12,
      "weekStart": 11
    },
    {
      "id": "ai-430-m1",
      "courseId": "ai-430",
      "summary": "Text-layer extraction for native PDFs and Word files, and the Qwen3-VL-8B path for designed PDFs.",
      "title": "Text and visual paths",
      "weekEnd": 3,
      "weekStart": 1
    },
    {
      "id": "ai-430-m2",
      "courseId": "ai-430",
      "summary": "Exact and semantic search, the routing heuristic, and the thin FastAPI layer.",
      "title": "Search and API",
      "weekEnd": 6,
      "weekStart": 4
    },
    {
      "id": "ai-430-m3",
      "courseId": "ai-430",
      "summary": "A UI pass in the Swiss/Bauhaus vocabulary. The part of the project that keeps it interesting.",
      "title": "Design review",
      "weekEnd": 8,
      "weekStart": 7
    },
    {
      "id": "ai-430-m4",
      "courseId": "ai-430",
      "summary": "Write the engineering rationale, then delete one component and rebuild it yourself.",
      "title": "Documentation",
      "weekEnd": 11,
      "weekStart": 10
    },
    {
      "id": "ai-430-m5",
      "courseId": "ai-430",
      "summary": "A two-minute screen recording and a public repository.",
      "title": "Demo day",
      "weekEnd": 12,
      "weekStart": 12
    },
    {
      "id": "bus-290-m1",
      "courseId": "bus-290",
      "summary": "Research the three MCL referrals, starting with NEbisco, then make contact.",
      "title": "Referrals",
      "weekEnd": 4,
      "weekStart": 1
    },
    {
      "id": "bus-290-m2",
      "courseId": "bus-290",
      "summary": "Turn one MH Hospitality automation opportunity into a written proposal.",
      "title": "Proposal",
      "weekEnd": 6,
      "weekStart": 5
    },
    {
      "id": "bus-290-m3",
      "courseId": "bus-290",
      "summary": "Pitch the proposal, using Tagger as the live demo.",
      "title": "Pitch",
      "weekEnd": 8,
      "weekStart": 7
    },
    {
      "id": "bus-290-m4",
      "courseId": "bus-290",
      "summary": "A signed engagement, or three documented pitches with what each one taught you.",
      "title": "Final",
      "weekEnd": 12,
      "weekStart": 12
    }
  ],
